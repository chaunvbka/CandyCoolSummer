.settings-panel {
    width: 80%;
    align-self: center;
    background-color: rgb(34, 34, 34);
}

.unity-toggle__input {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 120px;
}

#settings__music-mute-toggle .unity-toggle__checkmark {
    width: 60px;
    height: 60px;
    background-image: url("project://database/Assets/Resources/Textures/AudioSettings/ToggleMusicOff.png?fileID=2800000&guid=300bb3d48ea446e40996cd62e10b064e&type=3#ToggleMusicOff");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

#settings__music-mute-toggle .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: url("project://database/Assets/Resources/Textures/AudioSettings/ToggleMusicOn.png?fileID=21300000&guid=85a0a941fca8ddf4cbdc24ece52b3647&type=3#ToggleMusicOn");
    background-color: rgba(0, 0, 0, 0);
}

#settings__sfx-mute-toggle .unity-toggle__checkmark {
    width: 60px;
    height: 60px;
    background-image: url("project://database/Assets/Resources/Textures/AudioSettings/ToggleSoundOff.png?fileID=21300000&guid=5e736042704c6674f969801c0d7bfae3&type=3#ToggleSoundOff");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

#settings__sfx-mute-toggle .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: url("project://database/Assets/Resources/Textures/AudioSettings/ToggleSoundOn.png?fileID=21300000&guid=781c3254a16e2414a8608d92a54dcd3b&type=3#ToggleSoundOn");
    background-color: rgba(0, 0, 0, 0);
}

.settings__slider-group {
    height: 50px;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    flex-direction: column;
    align-self: center;
}

.settings-volume__label-container {
    width: 160px;
}

.settings-volume__label {
    align-self: center;
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-font-definition: resource('Fonts/Roboto-Medium');
}
